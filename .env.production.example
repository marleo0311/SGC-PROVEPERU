# Copiar como .env.production únicamente en el servidor. Nunca subir el archivo real.
APP_HTTP_PORT=80

POSTGRES_DB=sgc_proveperu_prod
POSTGRES_USER=proveperu_app
POSTGRES_PASSWORD=GENERAR_CONTRASENA_POSTGRES_DISTINTA_Y_SEGURA

# Habilitar solo durante el primer inicio; volver a false después de comprobar el acceso.
ADMIN_INITIAL_ENABLED=true
ADMIN_INITIAL_RESET_PASSWORD=false
ADMIN_INITIAL_LOGIN=admin
ADMIN_INITIAL_PASSWORD=GENERAR_CONTRASENA_ADMIN_DISTINTA_Y_SEGURA
ADMIN_INITIAL_NAME=Administrador del sistema

JWT_SECRET=GENERAR_SECRETO_BASE64_DE_AL_MENOS_32_BYTES
JWT_ISSUER=sgc-proveperu-production
JWT_EXPIRATION=PT2H

DOCUMENT_LOOKUP_ENABLED=false
DOCUMENT_LOOKUP_DNI_ENABLED=false
DOCUMENT_LOOKUP_BASE_URL=https://api.decolecta.com/v1
DOCUMENT_LOOKUP_TOKEN=CONFIGURAR_SOLO_SI_SE_CONTRATA_EL_PROVEEDOR
DOCUMENT_LOOKUP_CONNECT_TIMEOUT=PT5S
DOCUMENT_LOOKUP_READ_TIMEOUT=PT10S
DOCUMENT_LOOKUP_CACHE_TTL=PT24H
DOCUMENT_LOOKUP_NEGATIVE_CACHE_TTL=PT5M
DOCUMENT_LOOKUP_CACHE_MAX_ENTRIES=5000
DOCUMENT_LOOKUP_RATE_LIMIT_REQUESTS=10
DOCUMENT_LOOKUP_RATE_LIMIT_WINDOW=PT1M
DOCUMENT_LOOKUP_RATE_LIMIT_MAX_USERS=10000
DOCUMENT_LOOKUP_RETRY_MAX_ATTEMPTS=3
DOCUMENT_LOOKUP_RETRY_DELAY=PT0.25S
DOCUMENT_LOOKUP_CIRCUIT_FAILURES=5
DOCUMENT_LOOKUP_CIRCUIT_OPEN_DURATION=PT30S

# Certificado tributario SUNAT. La ruta es del host; Docker lo monta en modo lectura.
SUNAT_CERTIFICATE_HOST_PATH=/opt/sgc-proveperu/secrets/certificado-sunat.p12
SUNAT_CERTIFICATE_PASSWORD=CONFIGURAR_CLAVE_PRIVADA_DEL_P12
SUNAT_ENABLED=true
SUNAT_AMBIENTE=PRODUCCION
SUNAT_PRODUCTION_ENABLED=false
SUNAT_SOL_USER=CONFIGURAR_USUARIO_SECUNDARIO_SOL
SUNAT_SOL_PASSWORD=CONFIGURAR_CLAVE_SECUNDARIA_SOL
SUNAT_CONNECT_TIMEOUT=PT15S
SUNAT_READ_TIMEOUT=PT45S

# El primer Resumen Diario real se enviará manualmente y bajo supervisión.
SUNAT_DAILY_SUMMARY_AUTO_ENABLED=false
SUNAT_DAILY_SUMMARY_AUTO_SEND=false
SUNAT_DAILY_SUMMARY_CRON=0 15 2 * * *
